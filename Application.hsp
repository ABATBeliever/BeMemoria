/*
 BeMemoria v0.8.4 [Beta]
 Made by ABATBeliever

 https://abatbeliever.net

*/

//ビルド設定エリア
#packopt version "Build.ini"	//詳細
#packopt icon "icon.ico"		//アイコン
#packopt hide 1

//===================================================================================

#include "hspext.as"		//UTF-8化
#include "hsp3utf.as"		//UTF-8化
#include "hspinet.as"		//ネット通信
#include "mod_regexp.as"	//正規表現一括変換

#include "lib/mod_openini.as"	//iniモジュール
#include "lib/mod_mdispinfo.as"	//画面モジュール

//定数
AppName          = "BeMemoria"
AppVer           = "0.8.4 Beta"
AppVerInt        = "0.8.4"

UseLLMTextCoreAPILevel = "1.0"

#define ctype HIWORD(%1) (%1 >> 16 & $FFFF)

//エラーハンドリング
onerror *onerror_handle
//終了時の処理の予約
onexit *exit

//システム設定のロード
SettingLoad

//DPIモード
#include "DPImodule.hsp"

//二重起動対策
#include "AppRunningmgr.hsp"

//タスクトレイ依存関係
#include "kernel32.as"
#include "shell32.as"
#include "user32.as"

//フォルダが存在するか
dirlist dummy,""+dir_cur+"/memo",5
if stat=0{dialog "「memo」フォルダがありません。\n実行ファイルと同じパスに「memo」フォルダを作ってから起動してください。":end}

exist ""+dir_cur+"/hspext.dll"
if strsize=-1{dialog "「hspext.dll」がexeと同じパスにありません。\nこれでは起動できません。",1:end}

title "メニューを表示する"
sdim FileName, 65535
GetModuleFileName hModule, varptr(FileName), 65535
ExtractIconEx varptr(FileName), 0, 0, varptr(hIconSmall), 1
hIcon = hIconSmall(0)
GetWindowTextLength hwnd
sdim WindowTitle, stat + 1
GetWindowText hwnd, varptr(WindowTitle), stat + 1
dim IconData,22
IconData(0) = 88
IconData(1) = hwnd
IconData(2) = 1
IconData(3) = 0x0007 // NIF_MESSAGE | NIF_ICON | NIF_TIP
IconData(4) = 0x0401 // WM_TRAYICON
IconData(5) = hIcon
poke IconData, 4 * 6, WindowTitle
Shell_NotifyIcon 0x00000000, varptr(IconData) // NIM_ADD
oncmd gosub *OnTrayIcon, 0x0401
oncmd gosub *OnSize, $0005
oncmd gosub *OnClickBox, $111

#module
	#defcfunc TrueScale int p1
	return 1.0*double(Var_ViewScale@)*p1
	#deffunc SetTitle str p1
		if p1=""{
			title AppName@+" v"+AppVer@
		}else{
			title AppName@+" v"+AppVer@+" | "+p1
		}
	return 0
#global

#include "DataScanner.hsp"

//GUI設定
screen 0,TrueScale(640),TrueScale(480),screen_hide					//画面サイズを設定
width ,,ginfo(20)/2-TrueScale(320),ginfo(21)/2-TrueScale(240)		//デスクトップの中心に表示
SetTitle ""
color 192,192,192:boxf:color 0,0,0			//色の初期化

pos 0,0:objsize TrueScale(640),TrueScale(40):dummy=": "+AppName+" へようこそ":font "",TrueScale(32):objmode 2
input dummy:objenable 0,0
pos 0,TrueScale(40):objsize TrueScale(640),TrueScale(340):dummy="メモをロード中...":font "",TrueScale(20)
mesbox dummy,,,0,0
gosub *MemoListLoad												//メモをロード
dummy+="\nメモを配置中...":objprm 1,dummy:gosub *SetMemo		//メモを配置

//予約ID
screen 1,100,100,screen_hide
screen 2,100,100,screen_hide
screen 3,100,100,screen_hide

gsel 0
pos TrueScale(  0),TrueScale(380):objsize TrueScale(160),TrueScale(50):button gosub "ようこそ",	*DisplayMode0
pos TrueScale(160),TrueScale(380):objsize TrueScale(160),TrueScale(50):button gosub "使い方",		*DisplayMode1
pos TrueScale(320),TrueScale(380):objsize TrueScale(160),TrueScale(50):button gosub "各種情報",	*DisplayMode2
pos TrueScale(480),TrueScale(380):objsize TrueScale(160),TrueScale(50):button gosub "更新確認",	*DisplayMode3
gosub *DisplayMode0
pos TrueScale(  0),TrueScale(430):objsize TrueScale(160),TrueScale(50):button "新しい付箋を書く",		*NewMemo
pos TrueScale(160),TrueScale(430):objsize TrueScale(160),TrueScale(50):button "付箋を編集/削除",		*SelectMemo
pos TrueScale(320),TrueScale(430):objsize TrueScale(160),TrueScale(50):button "ﾛｰｶﾙAIに尋ねる",		*AIManager_SelGUI
pos TrueScale(480),TrueScale(430):objsize TrueScale(160),TrueScale(50):button gosub "設定",			*Setting_GUI_System

/*
0     : ようこそ画面
1     : 設定画面
2     : AIウィンドウ
3     : 新しいメモ / メモを編集 / AI付箋管理
4以上 : memo
*/

hWndList(0)=hwnd
gosub *SaveMemoMetaData

switch Var_HideWhenBoot
	case 0 //0なら普通の処理
		//全面表示設定
		if Var_isForceTop {gsel 0,2}else{gsel 0,1}
		swbreak
	case 1 //最小化する
		gsel 0
		sendmsg hwnd, $112, $F020
		if Var_isForceTop {gsel 0,2}else{gsel 0,1}
		swbreak
	default //2ならどうするか聞く(初回)
		if Var_isForceTop {gsel 0,2}else{gsel 0,1}
		dialog "次回以降の起動時にも、ようこそ画面を表示していいですか?\n\n表示する場合は「OK」、表示しない場合は「キャンセル」を選んで下さい。\n\n※いつでも「設定」から変更できます。\n※表示しない場合は、タスクトレイのアイコンを押して再表示できます。",2,"はじめまして"
		if stat=6{//する
			Setini_File dir_cur+"\\Config.ini"
			Setini_int "graphic","HideWhenBoot",0
			Var_HideWhenBoot=0
		}else{//しない
			Setini_File dir_cur+"\\Config.ini"
			Setini_int "graphic","HideWhenBoot",1
			Var_HideWhenBoot=1
		}
		swbreak
	swend
	
stop

/////////////////////////////////////////////////////
//スタティックエリア
#include "InternetManager.hsp"
#include "MemoLoader.hsp"
#include "DisplayModeManager.hsp"
#include "NewMemo.hsp"
#include "SettingMGR.hsp"
#include "LocalLLMManager.hsp"
#include "SettingLoader.hsp"
stop

*onerror_handle
	tmp ="エラーが起こりました。"+AppName+"を終了します。\n\n"
	tmp+="ﾊﾞｰｼﾞｮﾝ:"+AppVer+"\n"
	tmp+="エラーコード: 0x"+strf("%04d",wparam)
	tmp+="\n\n上記のデバッグ情報と状況を報告してくださると、修正の助けになります！"
	dialog tmp,1
end

*OnTrayIcon
if (wparam == 1) {
	switch (lparam)
		case 0x0201 // WM_LBUTTONDOWN
			ShowWindow hwnd,4
			swbreak
	swend
}
return

*OnSize
    if wparam=1 { gsel 0,-1 }
return 

*OnClickBox
	if lparam=hReplaceFeedListBox{
		if HIWORD(wparam) = 1 {
			sendmsg hReplaceFeedListBox, $188
			tmp=stat
			if tmp=-1{return}
			objenable 10,1:objenable 12,1:objenable 13,1:objenable 14,1
			INPUT_P2=ReplaceFeedP2(tmp):objprm 10,INPUT_P2
			INPUT_P3=ReplaceFeedP3(tmp):objprm 12,INPUT_P3
			INPUT_P4=ReplaceFeedP4(tmp):objprm 13,INPUT_P4
			INPUT_P6=ReplaceFeedP6(tmp):objprm 14,INPUT_P6
			objenable 10,0:objenable 12,0:objenable 13,0:objenable 14,0
		}
	}
return

*onjump
	if wparam = 1 {
		sendmsg hWndList(ginfo(2)), $A1, 2
	return
	}
return

*vscroll
	if lparam = hTrackbarOpacity {
		sendmsg hTrackbarOpacity, $400
		Var_Opacity=stat
		if Var_Opacity>90{Var_Opacity=90}
		gsel 1 : objprm 10,"付箋の透明度("+str(Var_Opacity)+"%)"
//		Var_Opacity=100-Var_Opacity
	}
return

*exit
	gosub *SaveMemoMetaData
end