*Setting_GUI_Commons
	gsel 0,-1
	screen 1,TrueScale(640),TrueScale(480),0
	hWndList(1)=hwnd
	GetWindowLong hwnd, -16
	SetWindowLong hwnd, -16, stat - $80000
	width ,,ginfo(20)/2-TrueScale(320),ginfo(21)/2-TrueScale(240)
	pos 0,0:objsize TrueScale(640),TrueScale(40):dummy="-":font "",TrueScale(32):objmode 2
	if Var_isForceTop {gsel 1,2}else{gsel 1,1}

	input dummy:objenable 0,0
	pos 0,TrueScale(40):objsize TrueScale(640),TrueScale(40)
	dummy="ここで各種設定ができます。全ての設定は次回起動時に反映されます。"
	font "",TrueScale(20)
	mesbox dummy,,,0,0

	pos              0,TrueScale(80):objsize TrueScale(320),TrueScale(40)
	button gosub "システム設定",*Setting_GUI_System
	pos TrueScale(320),TrueScale(80):objsize TrueScale(320),TrueScale(40)
	button gosub "AI関連の高度な設定",*Setting_GUI_AI
	objsize TrueScale(160),TrueScale(40):font "",TrueScale(16)
return

*Setting_GUI_System
	gosub *Setting_GUI_Commons
	objprm 0,":設定 - システム設定"
	objenable 2,0
	//DPI
	font "",TrueScale(16)
	pos              0,TrueScale(120):objsize TrueScale(600),TrueScale(40)
	dummy="-":mesbox dummy,,,0,0:objenable 4,0
	pos TrueScale(600),TrueScale(120):objsize TrueScale( 40),TrueScale(40)
	button gosub "変更",*Setting_DPIModeChange:gosub *Setting_DPIModeChange:gosub *Setting_DPIModeChange:gosub *Setting_DPIModeChange//現在を表示するために3回変える

	pos 0,TrueScale(160):objsize TrueScale(320),TrueScale(40)
	dummy="ようこそウィンドウを最前面表示する"	:chkbox dummy,Var_isForceTop
	
	pos 0,TrueScale(200):objsize TrueScale(320),TrueScale(40)
	dummy="ようこそウィンドウを自動で隠す"		:chkbox dummy,Var_HideWhenBoot

	pos              0,TrueScale(240):objsize TrueScale(280),TrueScale(40)
	dummy="画面と付箋のスケール(倍)":input dummy,,,0:objenable 8,0
	pos TrueScale(280),TrueScale(240):objsize TrueScale(40),TrueScale(40)
	NEW_ViewScale=Var_ViewScale
	input NEW_ViewScale,,,4

	pos TrueScale(320),TrueScale(160):objsize TrueScale(280),TrueScale(40)
	dummy="付箋の透明度(%)":input dummy,,,0:objenable 10,0
	pos TrueScale(600),TrueScale(160):objsize TrueScale(40),TrueScale(40)
	sdim Var_OpacitySTR : Var_OpacitySTR=str(100-Var_Opacity):input Var_OpacitySTR,,,4

	pos TrueScale(320),TrueScale(200):objsize TrueScale(240),TrueScale(40)
	dummy="付箋の文字色":input dummy,,,0:objenable 12,0
	color TCol_R,TCol_G,TCol_B : boxf TrueScale(560),TrueScale(200),TrueScale(600),TrueScale(240)
	pos TrueScale(600),TrueScale(200):objsize TrueScale( 40),TrueScale(40)
	button gosub "変更",*Setting_TextColor

	pos TrueScale(320),TrueScale(240):objsize TrueScale(240),TrueScale(40)
	dummy="付箋の背景色":input dummy,,,0:objenable 14,0
	color BGCol_R,BGCol_G,BGCol_B : boxf TrueScale(560),TrueScale(240),TrueScale(600),TrueScale(280)
	pos TrueScale(600),TrueScale(240):objsize TrueScale( 40),TrueScale(40)
	button gosub "変更",*Setting_BackColor

	pos TrueScale(  0),TrueScale(280):objsize TrueScale(320),TrueScale(120)
	dummy="文字サイズ\n\n付箋の文字の大きさを指定します。\n\nこの数字は「画面と付箋のスケール」\nの影響をうけます。"
	mesbox  dummy,,,0,0
	pos TrueScale(  0),TrueScale(400):objsize TrueScale( 64),TrueScale(40):dummy="h1 ｻｲｽﾞ":input dummy,,,0:objenable 17,0
	pos TrueScale(  0),TrueScale(440):objsize TrueScale( 64),TrueScale(40):Var_h1SizeSTR=str(Var_h1Size):input Var_h1SizeSTR,,,0
	pos TrueScale( 64),TrueScale(400):objsize TrueScale( 64),TrueScale(40):dummy="h2 ｻｲｽﾞ":input dummy,,,0:objenable 19,0
	pos TrueScale( 64),TrueScale(440):objsize TrueScale( 64),TrueScale(40):Var_h2SizeSTR=str(Var_h2Size):input Var_h2SizeSTR,,,0
	pos TrueScale(128),TrueScale(400):objsize TrueScale( 64),TrueScale(40):dummy="h3 ｻｲｽﾞ":input dummy,,,0:objenable 21,0
	pos TrueScale(128),TrueScale(440):objsize TrueScale( 64),TrueScale(40):Var_h3SizeSTR=str(Var_h3Size):input Var_h3SizeSTR,,,0
	pos TrueScale(192),TrueScale(400):objsize TrueScale( 64),TrueScale(40):dummy="h4 ｻｲｽﾞ":input dummy,,,0:objenable 23,0
	pos TrueScale(192),TrueScale(440):objsize TrueScale( 64),TrueScale(40):Var_h4SizeSTR=str(Var_h4Size):input Var_h4SizeSTR,,,0
	pos TrueScale(256),TrueScale(400):objsize TrueScale( 64),TrueScale(40):dummy="普通":input dummy,,,0:objenable 25,0
	pos TrueScale(256),TrueScale(440):objsize TrueScale( 64),TrueScale(40):Var_NormalSTR=str(Var_Normal):input Var_NormalSTR,,,0

	pos TrueScale(320),TrueScale(400):objsize TrueScale(160),TrueScale(40):button gosub "'設定を開く前'に戻す"	,*Setting_ReloadSettings_ASK
	pos TrueScale(480),TrueScale(400):objsize TrueScale(160),TrueScale(40):button "'既定値'に戻す"		,*Setting_RegeneSettings_ASK
	pos TrueScale(320),TrueScale(440):objsize TrueScale(160),TrueScale(40):button "変更を保存せず閉じる"		,*Setting_GUI_Close
	pos TrueScale(480),TrueScale(440):objsize TrueScale(160),TrueScale(40):button "変更を保存して閉じる"		,*Setting_GUI_SAVE
return

*Setting_TextColor
	dialog "",33
	if stat=0 : return
	TCol_R=ginfo_r : TCol_G=ginfo_g : TCol_B=ginfo_b : color TCol_R,TCol_G,TCol_B
	boxf TrueScale(560),TrueScale(200),TrueScale(600),TrueScale(240)
return

*Setting_BackColor
	dialog "",33
	if stat=0 : return
	BGCol_R=ginfo_r : BGCol_G=ginfo_g : BGCol_B=ginfo_b : color BGCol_R,BGCol_G,BGCol_B
	boxf TrueScale(560),TrueScale(240),TrueScale(600),TrueScale(280)
return

*Setting_DPIModeChange
	switch Var_DPIMode
		case 0
			dummy="DPIモードは「WindowsXP互換」\nSetProcessDPIAwareを強制します。「通常」がうまくいかない場合にお試しください。"
			Var_DPIMode=1
			objprm 4,dummy
			swbreak
		case 1
			dummy="DPIモードは「通常(推奨)」\n一般的なDPI処理で、たいていの環境に合っています。"
			Var_DPIMode=2
			objprm 4,dummy
			swbreak
		default
			dummy="DPIモードは「無効」\nドライバが当たらない環境、または仮想OS環境向け。"
			Var_DPIMode=0
			objprm 4,dummy
			swbreak
	swend
return

*Setting_GUI_AI
	gosub *Setting_GUI_Commons
	objprm 0,":設定 - AI関連の高度な設定"
	objenable 3,0
	//AI
	font "",TrueScale(16)
	pos TrueScale(320),TrueScale(120):objsize TrueScale(270),TrueScale(40)
	dummy="サンプリング時間(ms)\nAIから応答を取得する頻度。":mesbox dummy,,,0,0:objenable 4,0
	pos TrueScale(590),TrueScale(120):objsize TrueScale(50),TrueScale(40)
	input Var_SamplingAwait,,,4

	pos TrueScale(320),TrueScale(160):objsize TrueScale(270),TrueScale(40)
	dummy="temperature(0以上の小数)\n生成される文章のランダム性。":mesbox dummy,,,0,0:objenable 6,0
	pos TrueScale(590),TrueScale(160):objsize TrueScale(50),TrueScale(40)
	input Var_LLMTemperature,,,4

	pos TrueScale(320),TrueScale(200):objsize TrueScale(270),TrueScale(40)
	dummy="最大ﾄｰｸﾝ数(自然数)\n生成していい最大のﾄｰｸﾝ量。":mesbox dummy,,,0,0:objenable 8,0
	pos TrueScale(590),TrueScale(200):objsize TrueScale(50),TrueScale(40)
	input Var_LLMMaxTokens,,,6

	pos TrueScale(320),TrueScale(240):objsize TrueScale(270),TrueScale(40)
	dummy="ｺﾝﾃｷｽﾄ長(自然数)\n一度に処理するﾄｰｸﾝ量の上限。":mesbox dummy,,,0,0:objenable 10,0
	pos TrueScale(590),TrueScale(240):objsize TrueScale(50),TrueScale(40)
	input Var_LLM_N_ctx,,,4

	pos TrueScale(320),TrueScale(280):objsize TrueScale(270),TrueScale(40)
	dummy="Nucleus Sampling(0～1の小数)\n選ぶ単語の候補を選ぶ強さ。":mesbox dummy,,,0,0:objenable 12,0
	pos TrueScale(590),TrueScale(280):objsize TrueScale(50),TrueScale(40)
	input Var_LLMNucleusSampling,,,4

	pos TrueScale(320),TrueScale(320):objsize TrueScale(270),TrueScale(40)
	dummy="堂々巡り抑制(0～1の小数)\n堂々巡りを抑制する強さ。":mesbox dummy,,,0,0:objenable 14,0
	pos TrueScale(590),TrueScale(320):objsize TrueScale(50),TrueScale(40)
	input Var_LLMRepeatPenalty,,,4

	pos TrueScale(320),TrueScale(360):objsize TrueScale(270),TrueScale(40)
	dummy="堂々巡り抑制 対象ﾄｰｸﾝ数(自然数)\n堂々巡りを抑制するﾄｰｸﾝ範囲。":mesbox dummy,,,0,0:objenable 16,0
	pos TrueScale(590),TrueScale(360):objsize TrueScale(50),TrueScale(40)
	input Var_LLMRepeatPenaltyTokens,,,4

	pos TrueScale(320),TrueScale(400):objsize TrueScale(160),TrueScale(40):button gosub "'設定を開く前'に戻す"	,*Setting_ReloadSettings_ASK
	pos TrueScale(480),TrueScale(400):objsize TrueScale(160),TrueScale(40):button "'既定値'に戻す"		,*Setting_RegeneSettings_ASK
	pos TrueScale(320),TrueScale(440):objsize TrueScale(160),TrueScale(40):button "変更を保存せず閉じる"		,*Setting_GUI_Close
	pos TrueScale(480),TrueScale(440):objsize TrueScale(160),TrueScale(40):button "変更を保存して閉じる"		,*Setting_GUI_SAVE

	pos TrueScale(  0),TrueScale(120):objsize TrueScale(160),TrueScale(120)
	dummy="think開始タグ\n\nAIの「思考の開始」\nのタグを指定。":mesbox dummy,,,0,0:objenable 22,0
	pos TrueScale(  0),TrueScale(240):objsize TrueScale(120),TrueScale(40)
	Input_AI_Think_Start_Tag="":input Input_AI_Think_Start_Tag,,,12
	pos TrueScale(120),TrueScale(240):objsize TrueScale( 40),TrueScale(40)
	button gosub "追加",*Setting_ThinkStartTagAdd
	pos TrueScale(160),TrueScale(120):objsize TrueScale(160),TrueScale(10)
	SEL_LLMThinkTagStart=0:listbox SEL_LLMThinkTagStart,TrueScale(120),LIST_LLMThinkTagStart
	pos TrueScale(160),TrueScale(240):objsize TrueScale(160),TrueScale(40)
	button gosub "タグをリストから消す",*Setting_ThinkStartTagDel
//+160
	pos TrueScale(  0),TrueScale(280):objsize TrueScale(160),TrueScale(120)
	dummy="think終了タグ\n\nAIの「思考の終了」\nのタグを指定。":mesbox dummy,,,0,0:objenable 27,0
	pos TrueScale(  0),TrueScale(400):objsize TrueScale(120),TrueScale(40)
	Input_AI_Think_END_Tag="":input Input_AI_Think_END_Tag,,,12
	pos TrueScale(120),TrueScale(400):objsize TrueScale( 40),TrueScale(40)
	button gosub "追加",*Setting_ThinkENDTagAdd
	pos TrueScale(160),TrueScale(280):objsize TrueScale(160),TrueScale(10)
	SEL_LLMThinkTagEND=0:listbox SEL_LLMThinkTagEND,TrueScale(120),LIST_LLMThinkTagEND
	pos TrueScale(160),TrueScale(400):objsize TrueScale(160),TrueScale(40)
	button gosub "タグをリストから消す",*Setting_ThinkENDTagDel

	pos TrueScale(0),TrueScale(440):objsize TrueScale(320),TrueScale(40):button gosub "AI出力を正規表現で置換する..."	,*Setting_GUI_AI_REGEXP
return

*Setting_ThinkStartTagAdd
	strrep Input_AI_Think_Start_Tag,"@",""
	if Input_AI_Think_Start_Tag="" {dialog "入力してください。" : return}
	sdim tmp : flag=0
	split Var_LLMThinkTagStart,"@",tmp
	repeat length(tmp)
		if tmp(cnt)=Input_AI_Think_Start_Tag{flag=1}
	loop
	if flag=1 {dialog "同じ内容がすでに登録されているようです。\n追加は行われません。":return}
	Var_LLMThinkTagStart+="@"+Input_AI_Think_Start_Tag
	LIST_LLMThinkTagSTART = Var_LLMThinkTagStart : strrep LIST_LLMThinkTagSTART,"@","\n"
	objprm 25,LIST_LLMThinkTagSTART
return

*Setting_ThinkStartTagDel
	sdim tmp
	split Var_LLMThinkTagStart,"@",tmp
	if length(tmp)=1 and tmp(0)="" {return}
	dialog "タグ「"+tmp(SEL_LLMThinkTagStart)+"」を削除しますか?",2
	if stat=7{return}
	sdim Var_LLMThinkTagStart
	flag=0//初回ではないことを示す
	repeat length(tmp)
		if cnt=SEL_LLMThinkTagStart{continue}
		if flag{
			Var_LLMThinkTagStart+="@"+tmp(cnt)
		}else{
			Var_LLMThinkTagStart=tmp(cnt)
			flag=1
		}
	loop
	LIST_LLMThinkTagSTART = Var_LLMThinkTagStart : strrep LIST_LLMThinkTagSTART,"@","\n"
	objprm 25,LIST_LLMThinkTagSTART
	SEL_LLMThinkTagStart=0
return

*Setting_ThinkENDTagAdd
	strrep Input_AI_Think_END_Tag,"@",""
	if Input_AI_Think_END_Tag="" {dialog "入力してください。" : return}
	sdim tmp : flag=0
	split Var_LLMThinkTagEND,"@",tmp
	repeat length(tmp)
		if tmp(cnt)=Input_AI_Think_END_Tag{flag=1}
	loop
	if flag=1 {dialog "同じ内容がすでに登録されているようです。\n追加は行われません。":return}
	Var_LLMThinkTagEND+="@"+Input_AI_Think_END_Tag
	LIST_LLMThinkTagEND = Var_LLMThinkTagEND : strrep LIST_LLMThinkTagEND,"@","\n"
	objprm 30,LIST_LLMThinkTagEND
return

*Setting_ThinkENDTagDel
	sdim tmp
	split Var_LLMThinkTagEND,"@",tmp
	if length(tmp)=1 and tmp(0)="" {return}
	dialog "タグ「"+tmp(SEL_LLMThinkTagEND)+"」を削除しますか?",2
	if stat=7{return}
	sdim Var_LLMThinkTagEND
	flag=0//初回ではないことを示す
	repeat length(tmp)
		if cnt=SEL_LLMThinkTagEND{continue}
		if flag{
			Var_LLMThinkTagEND+="@"+tmp(cnt)
		}else{
			Var_LLMThinkTagEND=tmp(cnt)
			flag=1
		}
	loop
	LIST_LLMThinkTagEND = Var_LLMThinkTagEND : strrep LIST_LLMThinkTagEND,"@","\n"
	objprm 30,LIST_LLMThinkTagEND
	SEL_LLMThinkTagEND=0
return

*Setting_ReloadSettings_ASK
	dialog "全ての設定キーは、設定画面を開く前に戻ります。\nよろしいですか?",2
	if stat=7{return}
	gosub *Setting_ReloadSettings
return

*Setting_ReloadSettings
	SettingLoad
	gosub *Setting_GUI_System
return

*Setting_RegeneSettings_ASK
	dialog "全ての設定キーは、既定値に戻ります。\nよろしいですか?",2
	if stat=7{stop}
	delete dir_cur+"\\Config.ini"
	SettingLoad
	goto *Setting_GUI_SAVE_DO
stop

*Estimate_ReplaceRule
sdim TmpReplaceFeedBlock
sdim ReplaceFeedP2//置換する構文
sdim ReplaceFeedP3//置換後の構文
 dim ReplaceFeedP4//大文字小文字を区別するか
 dim ReplaceFeedP6//全体を1行とみなすか
split Var_ReplaceFeed,";",TmpReplaceFeedBlock //@区切りの構造体

dim valid
repeat length(TmpReplaceFeedBlock)
	sdim tmp
	split TmpReplaceFeedBlock(cnt),"@",tmp
	if length(tmp)!=4{//破損している場合
		continue
	}else{
		ReplaceFeedP2(valid)=str(tmp(0))
		ReplaceFeedP3(valid)=str(tmp(1))
		ReplaceFeedP4(valid)=int(tmp(2))
		ReplaceFeedP6(valid)=int(tmp(3))
		valid++
	}
loop

sdim LIST_ReplaceFeedP2
repeat length(ReplaceFeedP2)
	if cnt=0{
		LIST_ReplaceFeedP2=ReplaceFeedP2(cnt)
	}else{
		LIST_ReplaceFeedP2+="\n"+ReplaceFeedP2(cnt)
	}
loop
SEL_ReplaceFeed=0
return

*Reconstruct_ReplaceRule
sdim Var_ReplaceFeed
repeat length(ReplaceFeedP2)
	if ReplaceFeedP2(cnt)=""{continue}
	Var_ReplaceFeed+=ReplaceFeedP2(cnt)+"@"+ReplaceFeedP3(cnt)+"@"+ReplaceFeedP4(cnt)+"@"+ReplaceFeedP6(cnt)+";"
loop
gosub *Estimate_ReplaceRule
return

*Setting_GUI_AI_REGEXP
	oncmd gosub *OnClickBox, $111
	gosub *Setting_GUI_Commons
	objprm 0,":設定 - AI関連の高度な設定 / 正規表現..."
	objenable 2,0
	//AI
	font "",TrueScale(16)

	pos TrueScale(  0),TrueScale(120):objsize TrueScale(320),TrueScale(120)
	dummy={"AI出力を正規表現で置換できます。
・ルールを追加するには、「ルールを追加」\n　をクリック。
・ルールを編集するには、リストで選んで\n　から「ルールの編集を開始」をクリック。
・ルールを削除するには、編集中に\n　「置換する構文」を空にして保存。"}
	mesbox dummy,,,0,0:objenable 4,0
	
	
	pos TrueScale(320),TrueScale(120):objsize TrueScale(320),TrueScale(120)
	dummy={"正規表現の記法はmod_regexp.asに依存します。"}
	mesbox dummy,,,0,0:objenable 5,0

	pos TrueScale(  0),TrueScale(240):objsize TrueScale(320),
	SEL_ReplaceFeed=0:listbox SEL_ReplaceFeed,TrueScale(180),LIST_ReplaceFeedP2
	hReplaceFeedListBox = objinfo(stat, 2)

	pos TrueScale(  0),TrueScale(440):objsize TrueScale(160),TrueScale(40)
	button gosub "ルールを追加",*Setting_AddReplaceRule
	pos TrueScale(160),TrueScale(440):objsize TrueScale(160),TrueScale(40)
	button gosub "ルールの編集を開始",*Setting_EditReplaceRule

	pos TrueScale(320),TrueScale(240):objsize TrueScale(180),TrueScale(40)
	dummy="置換する構文\n置換範囲ときっかけ。":mesbox dummy,,,0,0:objenable 9,0
	pos TrueScale(500),TrueScale(240):objsize TrueScale(140),TrueScale(40)
	INPUT_P2="":input INPUT_P2,,,128:objenable 10,0

	pos TrueScale(320),TrueScale(280):objsize TrueScale(180),TrueScale(40)
	dummy="置換後の構文\n置換をした後の構文。":mesbox dummy,,,0,0:objenable 11,0
	pos TrueScale(500),TrueScale(280):objsize TrueScale(140),TrueScale(40)
	INPUT_P3="":input INPUT_P3,,,128:objenable 12,0

	pos TrueScale(320),TrueScale(320):objsize TrueScale(320),TrueScale(40)
	INPUT_P4=0 :dummy="アルファベットの大文字小文字を区別します":chkbox dummy,INPUT_P4:objenable 13,0

	pos TrueScale(320),TrueScale(360):objsize TrueScale(320),TrueScale(40)
	INPUT_P6=0 :dummy="複数行にまたがっていても処理します"		:chkbox dummy,INPUT_P6:objenable 14,0

	pos TrueScale(320),TrueScale(400):objsize TrueScale(160),TrueScale(40):button gosub "'設定を開く前'に戻す"	,*Setting_ReloadSettings_ASK
	pos TrueScale(480),TrueScale(400):objsize TrueScale(160),TrueScale(40):button "'既定値'に戻す"		,*Setting_RegeneSettings_ASK
	pos TrueScale(320),TrueScale(440):objsize TrueScale(160),TrueScale(40):button "変更を保存せず閉じる"		,*Setting_GUI_Close
	pos TrueScale(480),TrueScale(440):objsize TrueScale(160),TrueScale(40):button "変更を保存して閉じる"		,*Setting_GUI_SAVE
	
	IsNowEditReplaceRule=0
	if length(ReplaceFeedP2)=1 and ReplaceFeedP2=""{objenable 8,0}
return

*Setting_AddReplaceRule
	if IsNowEditReplaceRule{
		dialog "ルールの変更を取りやめますか?",2
		if stat=7{return}
		IsNowEditReplaceRule=0
		objenable 6,1
		objenable 10,0:objenable 12,0:objenable 13,0:objenable 14,0
		objenable  3,1:objenable 15,1:objenable 16,1:objenable 17,1:objenable 18,1
		objprm 7,"ルールを追加" : objprm 8,"ルールの編集を開始"
		INPUT_P2="":objprm 10,INPUT_P2
		INPUT_P3="":objprm 12,INPUT_P3
		INPUT_P4=0 :objprm 13,INPUT_P4
		INPUT_P6=0 :objprm 14,INPUT_P6
		if length(ReplaceFeedP2)=1 and ReplaceFeedP2=""{objenable 8,0}
	}else{
		Var_ReplaceFeed+=";新しいルール@@1@1"
		gosub *Estimate_ReplaceRule
		objprm 6,LIST_ReplaceFeedP2
		SEL_ReplaceFeed=length(ReplaceFeedP2)-1

		gosub *Setting_EditReplaceRule
	}
return

*Setting_EditReplaceRule
	if IsNowEditReplaceRule{
		strrep INPUT_P2,"@",""
		strrep INPUT_P2,";",""
		if INPUT_P2=""{
			dialog "このルールを削除しますか?",2
		}else{
			dialog "ルールを保存しますか?",2
		}
		if stat=7{return}
		
		strrep INPUT_P3,"@","" : strrep INPUT_P3,";",""
		ReplaceFeedP2(SEL_ReplaceFeed)=INPUT_P2
		ReplaceFeedP3(SEL_ReplaceFeed)=INPUT_P3
		ReplaceFeedP4(SEL_ReplaceFeed)=INPUT_P4
		ReplaceFeedP6(SEL_ReplaceFeed)=INPUT_P6
		gosub *Reconstruct_ReplaceRule
		
		objprm 6,LIST_ReplaceFeedP2
		IsNowEditReplaceRule=0
		objenable 6,1
		objenable 10,0:objenable 12,0:objenable 13,0:objenable 14,0
		objenable  3,1:objenable 15,1:objenable 16,1:objenable 17,1:objenable 18,1
		objprm 7,"ルールを追加" : objprm 8,"ルールの編集を開始"
		INPUT_P2="":objprm 10,INPUT_P2
		INPUT_P3="":objprm 12,INPUT_P3
		INPUT_P4=0 :objprm 13,INPUT_P4
		INPUT_P6=0 :objprm 14,INPUT_P6
		if length(ReplaceFeedP2)=1 and ReplaceFeedP2=""{objenable 8,0}
	}else{
		objenable 6,0
		objenable 8,1:objenable 10,1:objenable 12,1:objenable 13,1:objenable 14,1
		objenable 3,0:objenable 15,0:objenable 16,0:objenable 17,0:objenable 18,0
		objprm 7,"ルールの変更を破棄" : objprm 8,"ルールを保存"
		INPUT_P2=ReplaceFeedP2(SEL_ReplaceFeed)	:objprm 10,INPUT_P2
		INPUT_P3=ReplaceFeedP3(SEL_ReplaceFeed)	:objprm 12,INPUT_P3
		INPUT_P4=ReplaceFeedP4(SEL_ReplaceFeed) :objprm 13,INPUT_P4
		INPUT_P6=ReplaceFeedP6(SEL_ReplaceFeed) :objprm 14,INPUT_P6
		IsNowEditReplaceRule=1
	}
return

*Setting_GUI_SAVE
	dialog "設定を上書き保存しますか?",2
	if stat=7{stop}
	goto *Setting_GUI_SAVE_DO

*Setting_GUI_SAVE_DO
	Setini_File dir_cur+"\\Config.ini"
	
	Setini_int "graphic","DPIMode",Var_DPIMode
 	Setini_int "graphic","IsForceTop",Var_isForceTop
	Setini_int "graphic","HideWhenBoot",Var_HideWhenBoot
	Setini_str "graphic","ViewScale",NEW_ViewScale
	Setini_int "graphic","Opacity",100-Var_Opacity

	Var_TextColor=""+TCol_R+","+TCol_G+","+TCol_B		:	Setini_str "graphic","TextColor",Var_TextColor
	Var_TextColor=""+BGCol_R+","+BGCol_G+","+BGCol_B	:	Setini_str "graphic","BackGroundColor",Var_BackGroundColor

	Setini_int "TextSize","h1Size",Var_h1Size
	Setini_int "TextSize","h2Size",Var_h2Size
	Setini_int "TextSize","h3Size",Var_h3Size
	Setini_int "TextSize","h4Size",Var_h4Size
	Setini_int "TextSize","Normal",Var_Normal

	Setini_str "LocalAI","SamplingAwait",Var_SamplingAwait
	Setini_str "LocalAI","LLMTemperature",Var_LLMTemperature
	Setini_str "LocalAI","LLMMaxTokens",Var_LLMMaxTokens
	Setini_str "LocalAI","LLM_N_ctx",Var_LLM_N_ctx
	Setini_str "LocalAI","LLMNucleusSampling",Var_LLMNucleusSampling
	Setini_str "LocalAI","LLMRepeatPenalty",Var_LLMRepeatPenalty
	Setini_str "LocalAI","LLMRepeatPenaltyTokens",Var_LLMRepeatPenaltyTokens
	Setini_str "LocalAI","ReplaceFeed",Var_ReplaceFeed

	strrep LIST_LLMThinkTagSTART,"\n","@" : LIST_LLMThinkTagSTART = Var_LLMThinkTagStart
	strrep LIST_LLMThinkTagEND  ,"\n","@" : LIST_LLMThinkTagEND   = Var_LLMThinkTagEND 
	Setini_str "LocalAI","LLMThinkTagStart",Var_LLMThinkTagStart
	Setini_str "LocalAI","LLMThinkTagEnd",Var_LLMThinkTagEnd

goto *Setting_GUI_Close

*Setting_GUI_Close
	gosub *Setting_ReloadSettings
	gsel 1,-1
	if Var_isForceTop {gsel 0,2}else{gsel 0,1}
stop